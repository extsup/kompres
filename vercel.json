{
  "rewrites": [
    { "source": "/img", "destination": "/api/image" },
    { "source": "/badge", "destination": "/api/badge" }
  ],
  "functions": {
    "api/image.js": { "maxDuration": 15 },
    "api/badge.js": { "maxDuration": 5 }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
